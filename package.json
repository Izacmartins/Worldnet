{
  "name": "worldnet",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:ui": "vite --host 0.0.0.0",
    "dev:api": "node --env-file-if-exists=.env --use-system-ca --use-env-proxy server/index.js",
    "start": "vite preview --host 0.0.0.0",
    "search:up": "node scripts/search-up.mjs",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/pages-smoke.mjs",
    "test:3d": "node tests/pages-smoke.mjs",
    "test:perf3d": "node tests/perf-3d.mjs",
    "test:pages": "node tests/pages-smoke.mjs",
    "dev:server": "node --env-file-if-exists=.env --use-system-ca --use-env-proxy scripts/dev.mjs",
    "start:server": "node --env-file-if-exists=.env --use-system-ca --use-env-proxy server/index.js --static",
    "test:live": "node --use-system-ca --use-env-proxy tests/live-sources.mjs"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "playwright-core": "1.64.1",
    "vite": "^6.3.5"
  }
}
